<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.SubState" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Light Theme Colors -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_variant_light</item>
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="android:windowBackground">@color/main_bg_light</item>

        <!-- Shape & Style -->
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Theme.SubState" parent="Base.Theme.SubState" />

    <!-- Circular and Square Icon Styles -->
    <style name="ShapeAppearanceOverlay.MaterialComponents.Test.50" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialComponents.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Custom card style for sleek look -->
    <style name="Widget.SubState.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>